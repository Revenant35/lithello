{
  "$schema": "../node_modules/oxlint/configuration_schema.json",
  "extends": ["../.oxlintrc.json"],
  "plugins": ["vitest"],
  "env": {
    "node": true
  },
  "overrides": [
    {
      "files": ["src/**/*.test.ts", "src/**/*.spec.ts"],
      "env": {
        "vitest": true
      },
      "rules": {
        "vitest/no-focused-tests": "error",
        "vitest/require-mock-type-parameters": "off"
      }
    }
  ]
}
