REDIS_URL=redis://127.0.0.1:6379
DATABASE_URL=postgres://lithello:lithello@127.0.0.1:5432/lithello

BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173
BETTER_AUTH_URL=http://localhost:4321

# Bump this way up locally (e.g. 300) if you need to sit at a breakpoint
# without the process self-evicting when its Redis heartbeat expires.
PRESENCE_HEARTBEAT_TTL_SECONDS=10
