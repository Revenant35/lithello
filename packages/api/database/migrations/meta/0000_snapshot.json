          "value": "\"game\".\"ended_at\" >= \"game\".\"started_at\""
        },
        "game_ended_requires_started": {
          "name": "game_ended_requires_started",
          "value": "\"game\".\"ended_at\" is null or \"game\".\"started_at\" is not null"
        },
